OPENAI_BASE_URL=https://llm.ax.example.ac.kr/v1
OPENAI_API_KEY=sk-...
AX_CHAT_MODEL=ax-local
AX_EMBED_MODEL=ax-embed
EMBED_DIM=1024
# 로컬 개발용 DB (배포 시에는 포털이 프로젝트 전용 DATABASE_URL을 넣어 줌)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# 선택 설정
MAX_UPLOAD_MB=30
TOP_K=5
# 로컬 개발 때만: 로그인 헤더 대신 쓸 사용자 이메일 (배포 환경에는 넣지 마세요)
# DEV_USER_EMAIL=me@test
